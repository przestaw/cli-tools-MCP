{
  "version": 2,
  "timeout_seconds": 30,
  "timeouts": {
    "api": 120
  },
  "defaults": {
    "github": "github.com",
    "gitlab": "gitlab.com",
    "azure": "dev.azure.com",
    "jira": "jira"
  },
  "profiles": {
    "jira": {
      "kind": "jira",
      "url": "https://jira.company.local",
      "auth": "bearer",
      "token_env": "WORKCTL_JIRA_TOKEN",
      "verify_tls": true
    },
    "github.com": {
      "kind": "github",
      "url": "https://api.github.com",
      "auth": "bearer",
      "token_env": "WORKCTL_GITHUB_TOKEN",
      "verify_tls": true,
      "default_repo": "owner/name",
      "repos": ["owner/name"]
    },
    "gitlab.com": {
      "kind": "gitlab",
      "url": "https://gitlab.com",
      "auth": "private-token",
      "token_env": "WORKCTL_GITLAB_TOKEN",
      "verify_tls": true,
      "default_project": "group/project",
      "projects": ["group/project"]
    },
    "dev.azure.com": {
      "kind": "azure",
      "url": "https://dev.azure.com/my-org",
      "token_env": "WORKCTL_AZURE_TOKEN",
      "verify_tls": true,
      "default_project": "MyProject"
    }
  },
  "modules": {
    "timeout_seconds": 120
  },
  "policy": {
    "allow_write": false,
    "confirm_writes": true
  },
  "mcp": {
    "max_output_bytes": 500000
  }
}
