{
  "version": 1,
  "timeout_seconds": 30,
  "modules": {
    "timeout_seconds": 120
  },
  "jira": {
    "url": "https://jira.company.local",
    "auth": "bearer",
    "username": "",
    "token_env": "WORKCTL_JIRA_TOKEN",
    "verify_tls": true,
    "ca_file": ""
  },
  "gitlab": {
    "url": "https://gitlab.company.local",
    "auth": "private-token",
    "token_env": "WORKCTL_GITLAB_TOKEN",
    "verify_tls": true,
    "ca_file": "",
    "default_project": "group/project",
    "projects": ["group/project"]
  },
  "github": {
    "url": "https://api.github.com",
    "auth": "bearer",
    "token_env": "WORKCTL_GITHUB_TOKEN",
    "verify_tls": true,
    "ca_file": "",
    "default_repo": "owner/name",
    "repos": ["owner/name"]
  },
  "policy": {
    "allow_write": false
  },
  "mcp": {
    "max_output_bytes": 500000
  }
}
